{
  "name": "@pixel-petals/agent",
  "version": "1.0.4",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@pixel-petals/agent",
      "version": "1.0.4",
      "workspaces": [
        "packages/*",
        "utils/*"
      ]
    },
    "node_modules/@pixel-petals/rules-code": {
      "resolved": "packages/rules-code",
      "link": true
    },
    "node_modules/@pixel-petals/rules-git": {
      "resolved": "packages/rules-git",
      "link": true
    },
    "node_modules/@pixel-petals/version": {
      "resolved": "utils/version",
      "link": true
    },
    "packages/rules-code": {
      "name": "@pixel-petals/rules-code",
      "version": "1.0.1"
    },
    "packages/rules-git": {
      "name": "@pixel-petals/rules-git",
      "version": "1.0.1"
    },
    "utils/version": {
      "name": "@pixel-petals/version",
      "version": "1.0.0",
      "bin": {
        "sync-version": "src/bump.js"
      }
    }
  }
}
