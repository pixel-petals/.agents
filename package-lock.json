{
  "name": "@px-petals/org.agents",
  "version": "1.2.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "@px-petals/org.agents",
      "version": "1.2.0",
      "workspaces": [
        "packages/*",
        "utils/*"
      ],
      "devDependencies": {
        "@px-petals/tools.packager": "github:pixel-petals/tools.packager"
      }
    },
    "node_modules/@package/response-style-direct": {
      "resolved": "packages/response-style-direct",
      "link": true
    },
    "node_modules/@package/rules-code": {
      "resolved": "packages/rules-code",
      "link": true
    },
    "node_modules/@package/rules-git": {
      "resolved": "packages/rules-git",
      "link": true
    },
    "node_modules/@package/skills-monorepo": {
      "resolved": "packages/skills-monorepo",
      "link": true
    },
    "node_modules/@package/skills-roku": {
      "resolved": "packages/skills-roku",
      "link": true
    },
    "node_modules/@px-petals/tools.packager": {
      "version": "0.1.0",
      "resolved": "git+ssh://git@github.com/pixel-petals/tools.packager.git#82e8dc53be0f97df90c44db303a09af87694d5ff",
      "dev": true,
      "workspaces": [
        "src/apps/*",
        "src/packages/*",
        "src/plugins/*",
        "src/utils/*",
        "tests/*",
        "tools/*"
      ],
      "bin": {
        "packager": "src/packages/local/src/cli.js"
      },
      "engines": {
        "node": ">=24"
      }
    },
    "node_modules/@util/version": {
      "resolved": "utils/version",
      "link": true
    },
    "packages/response-style-direct": {
      "name": "@package/response-style-direct",
      "version": "1.2.0"
    },
    "packages/rules-code": {
      "name": "@package/rules-code",
      "version": "1.2.0"
    },
    "packages/rules-git": {
      "name": "@package/rules-git",
      "version": "1.2.0"
    },
    "packages/skills-monorepo": {
      "name": "@package/skills-monorepo",
      "version": "1.2.0"
    },
    "packages/skills-roku": {
      "name": "@package/skills-roku",
      "version": "1.2.0"
    },
    "utils/version": {
      "name": "@util/version",
      "version": "1.0.0",
      "bin": {
        "sync-version": "src/bump.js"
      }
    }
  }
}
