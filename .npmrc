
# npm settings
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■

# package scripts
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# Only run lifecycle scripts if a package defines them (no-op otherwise)
if-present=true

# package dependencies
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# Record installs in package.json automatically
save=true

# Pin exact versions — no ^ or ~ ranges
save-exact=true

# Install file: dependencies as packed copies, not symlinks to their folder
install-links=true

# Record installs under devDependencies by default
save-dev=true

# Security
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# Fail install if the project's engines field isn't satisfied
engine-strict=true

# Whitelist of packages allowed to run install scripts (empty = none)
allow-scripts=

# npx
# ▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬▬

# Require packages to be installed before npx can run them
yes=false

# Project vs Global Configuration
# ■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■

# This file in project root: affects only this project
# ~/.npmrc: affects all projects for your user
# /etc/npmrc: affects all users on the system

# Priority (highest to lowest):
# 1. Command-line flags
# 2. Project .npmrc
# 3. User ~/.npmrc
# 4. Global /etc/npmrc
# 5. npm defaults
