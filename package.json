{
  "metapak": {
    "configs": [
      "main"
    ]
  },
  "name": "@px-petals/org.agents",
  "version": "1.3.0",
  "private": true,
  "author": "Pixel Petals",
  "license": "Apache-2.0",
  "description": "Claude Code plugin marketplace for Pixel Petals: rules, agents and skills plugins.",
  "repository": {
    "url": "https://github.com/pixel-petals/.agents",
    "type": "git"
  },
  "// EXPORTS": "■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■",
  "bin": {},
  "scripts": {
    "dependencies": "packager link || exit 0",
    "lint": "eslint .",
    "metapak": "metapak-px",
    "package:response-style-direct": "npm run --workspace @package/response-style-direct",
    "package:rules-code": "npm run --workspace @package/rules-code",
    "package:rules-git": "npm run --workspace @package/rules-git",
    "package:skills-monorepo": "npm run --workspace @package/skills-monorepo",
    "package:skills-roku": "npm run --workspace @package/skills-roku",
    "test": "ws-run test",
    "typecheck": "ws-run typecheck",
    "util:version": "npm run --workspace @util/version",
    "version": "sync-version"
  },
  "imports": {},
  "exports": {},
  "files": [],
  "// USES": "■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■■",
  "workspaces": [
    "src/.tests/*",
    "src/apps/*",
    "src/packages/*",
    "src/plugins/*",
    "src/tools/*",
    "src/utils/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {},
  "devDependencies": {
    "@px-petals/metapak-dependencies": "github:pixel-petals/.dependencies",
    "@px-petals/shell.toolkit": "github:pixel-petals/shell.toolkit",
    "@px-petals/tools.packager": "github:pixel-petals/tools.packager",
    "@px-petals/web.toolkit": "github:pixel-petals/web.toolkit",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "metapak": "7.1.1",
    "typescript": "6.0.3",
    "vitest": "5.0.1"
  },
  "peerDependenciesMeta": {},
  "type": "module"
}
